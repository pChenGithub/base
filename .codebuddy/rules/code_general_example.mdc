```text
// 正确：模块 = 一对 .c/.h；对外能力只有自身职责，跨层动作由调用方注入
/* a_engine.c */  int a_run(A_CTX* ctx, const A_APPLY* apply);   // 纯逻辑，可单测
/* b_impl.c   */  int b_route_add(...);                          // 真正落地系统动作
/* c_main.c   */  static const A_APPLY kApply = { b_route_add, b_route_del };
                  a_run(&ctx, &kApply);                          // 上层注入，无横向依赖
